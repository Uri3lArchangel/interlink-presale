# Public URL of the site, used in email links
NEXT_PUBLIC_SITE_URL=https://presale.interlink.example

# Pouch (Liquifia) fiat API. Leave POUCH_SECRET_KEY empty in development to use mock payments.
POUCH_SECRET_KEY=
POUCH_API_URL=https://fiat-api.pouchfinance.xyz
# Webhook signing secret from Pouch, if they issue one. Payments are re-verified against the API regardless.
POUCH_WEBHOOK_SECRET=

# Order storage (Upstash Redis). Required in production.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Transactional email, checked in this order: Resend (RESEND_API_KEY + EMAIL_FROM), SMTP, Gmail.
# Option 0, your own mailbox over SMTP, e.g. Namecheap Private Email:
SMTP_HOST=mail.privateemail.com
SMTP_PORT=465
SMTP_USER=info@yourdomain.com
SMTP_PASSWORD=
# Option A, Gmail (no domain needed): the Gmail address and a 16-character app password
# (Google Account > Security > 2-Step Verification > App passwords).
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Option B, Resend (needs a verified domain to reach customers). Gmail wins if both are set.
RESEND_API_KEY=
EMAIL_FROM=Interlink <orders@yourdomain.com>
NEXT_PUBLIC_SUPPORT_EMAIL=info@interlinknetwork.link

# Test pricing: charge this many naira for every item (e.g. 100) to try the real payment flow.
# Remove it and redeploy to restore real prices. A banner shows while it is on.
NEXT_PUBLIC_TEST_PRICE_NAIRA=

# Crypto payments (Dextopus). Crypto checkout appears only when all three are set.
DEXTOPUS_API_KEY=
# Your wallet that receives USDC on Base (0x… address you control).
CRYPTO_SETTLEMENT_ADDRESS=
# Naira per US dollar used to price crypto payments, e.g. 1550. You set and update this.
CRYPTO_NGN_PER_USD=
# Secret returned when you register https://<domain>/api/webhooks/dextopus as the webhook URL.
DEXTOPUS_WEBHOOK_SECRET=

# Naira per Espee, used only to show approximate Espees prices (payment is still naira or crypto).
NEXT_PUBLIC_NGN_PER_ESPEE=2050
